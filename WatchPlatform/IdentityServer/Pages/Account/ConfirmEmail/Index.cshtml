@page
@model IdentityServer.Pages.ConfirmEmail.Index

<div class="confirm-email-page">
    <div class="lead">
        <h1>Email Confirmation</h1>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    @if (Model.EmailConfirmed)
                    {
                        <h2>Email Confirmed</h2>
                    }
                    else
                    {
                        <h2>Confirmation Failed</h2>
                    }
                </div>

                <div class="card-body">
                    @if (Model.EmailConfirmed)
                    {
                        <div class="alert alert-success">
                            @Model.StatusMessage
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            @Model.StatusMessage
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3">
                <p><a asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.ReturnUrl">Go to Login</a></p>
            </div>
        </div>
    </div>
</div>
