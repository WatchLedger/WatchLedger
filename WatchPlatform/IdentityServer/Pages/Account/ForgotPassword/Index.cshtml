@page
@model IdentityServer.Pages.ForgotPassword.Index

<div class="forgot-password-page">
    <div class="lead">
        <h1>Forgot Password</h1>
        <p>Enter your email to reset your password</p>
    </div>

    <partial name="_ValidationSummary"/>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h2>Reset Password</h2>
                </div>

                <div class="card-body">
                    <form asp-page="/Account/ForgotPassword/Index" method="post">
                        <div class="form-group">
                            <label asp-for="Input.Email"></label>
                            <input class="form-control" asp-for="Input.Email" autofocus/>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Send Reset Link</button>
                    </form>
                </div>
            </div>

            <div class="mt-3">
                <p><a asp-page="/Account/Login/Index">Back to Login</a></p>
            </div>
        </div>
    </div>
</div>
