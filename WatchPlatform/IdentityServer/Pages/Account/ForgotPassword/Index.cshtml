@page
@model IdentityServer.Pages.ForgotPassword.Index

<div class="forgot-password-page">
    <div class="lead">
        <h1>Reset password</h1>
        <p>Enter your email and we'll send you a reset link</p>
    </div>

    <partial name="_ValidationSummary"/>

    <div class="card">
        <div class="card-body">
            <form asp-page="/Account/ForgotPassword/Index" method="post">
                <div class="form-group">
                    <label asp-for="Input.Email">Email address</label>
                    <input class="form-control" asp-for="Input.Email" placeholder="name@example.com" autofocus/>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Send reset link</button>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <p>Remember your password? <a asp-page="/Account/Login/Index">Sign in</a></p>
    </div>
</div>
