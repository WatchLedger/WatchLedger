@page
@model IdentityServer.Pages.ForgotPasswordConfirmation.Index

<div class="forgot-password-confirmation-page">
    <div class="lead">
        <h1>Check your email</h1>
        <p>We've sent you a password reset link</p>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="alert alert-info" style="margin-bottom: 0;">
                If an account exists with the email you provided, you'll receive a password reset link shortly. Check your spam folder if you don't see it.
            </div>
        </div>
    </div>

    <div class="mt-3">
        <p><a asp-page="/Account/Login/Index">Back to sign in</a></p>
    </div>
</div>
