@page
@model IdentityServer.Pages.ForgotPasswordConfirmation.Index

<div class="forgot-password-confirmation-page">
    <div class="lead">
        <h1>Check Your Email</h1>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h2>Password Reset Email Sent</h2>
                </div>

                <div class="card-body">
                    <p>If an account exists with the email you provided, we've sent a password reset link.</p>
                    <p>Please check your email and click the link to reset your password.</p>
                    <p>If you don't see the email, check your spam folder.</p>
                </div>
            </div>

            <div class="mt-3">
                <p><a asp-page="/Account/Login/Index">Back to Login</a></p>
            </div>
        </div>
    </div>
</div>
