@page
@model IdentityServer.Pages.Login.Index

<div class="login-page">
    <div class="lead">
        <h1>Welcome back</h1>
        <p>Sign in to your account to continue</p>
    </div>

    <partial name="_ValidationSummary"/>

    @if (Model.View.EnableLocalLogin)
    {
        <div class="card">
            <div class="card-body">
                <form asp-page="/Account/Login/Index">
                    <input type="hidden" asp-for="Input.ReturnUrl"/>

                    <div class="form-group">
                        <label asp-for="Input.Username">Email</label>
                        <input class="form-control" placeholder="name@example.com" asp-for="Input.Username" autofocus>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Password">Password</label>
                        <input type="password" class="form-control" placeholder="Enter your password" asp-for="Input.Password" autocomplete="current-password">
                    </div>

                    @if (Model.View.AllowRememberLogin)
                    {
                        <div class="form-group">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberLogin" id="RememberLogin">
                                <label class="form-check-label" for="RememberLogin">Remember me</label>
                            </div>
                        </div>
                    }

                    <button class="btn btn-primary" name="Input.Button" value="login">Sign in</button>
                    <button class="btn btn-secondary" name="Input.Button" value="cancel">Cancel</button>
                </form>

                <div class="mt-3" style="text-align: left;">
                    <a asp-page="/Account/ForgotPassword/Index">Forgot password?</a>
                </div>
            </div>
        </div>

        @if (Model.View.VisibleExternalProviders.Any())
        {
            <div class="divider">or continue with</div>

            <div class="card">
                <div class="card-body">
                    <ul class="list-inline">
                        @foreach (var provider in Model.View.VisibleExternalProviders)
                        {
                            <li class="list-inline-item">
                                <a class="btn btn-secondary"
                                   asp-page="/ExternalLogin/Challenge"
                                   asp-route-scheme="@provider.AuthenticationScheme"
                                   asp-route-returnUrl="@Model.Input.ReturnUrl">
                                    @provider.DisplayName
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div class="mt-3">
            <p>Don't have an account? <a asp-page="/Account/Register/Index" asp-route-returnUrl="@Model.Input.ReturnUrl">Sign up</a></p>
        </div>
    }

    @if (!Model.View.EnableLocalLogin && !Model.View.VisibleExternalProviders.Any())
    {
        <div class="alert alert-warning">
            <strong>Invalid login request</strong> — No login schemes configured.
        </div>
    }
</div>
