@page
@model IdentityServer.Pages.Register.Index

<div class="register-page">
    <div class="lead">
        <h1>Create an account</h1>
        <p>Start managing your watch collection today</p>
    </div>

    <partial name="_ValidationSummary"/>

    @if (!Model.View.AllowRegistration)
    {
        <div class="alert alert-warning">
            @IdentityServer.Pages.Register.RegisterOptions.RegistrationDisabledMessage
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <form asp-page="/Account/Register/Index" method="post">
                    <input type="hidden" asp-for="Input.ReturnUrl"/>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Input.FirstName">First name</label>
                                <input class="form-control" asp-for="Input.FirstName" placeholder="John" autofocus/>
                                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Input.LastName">Last name</label>
                                <input class="form-control" asp-for="Input.LastName" placeholder="Doe"/>
                                <span asp-validation-for="Input.LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Email">Email address</label>
                        <input class="form-control" asp-for="Input.Email" placeholder="name@example.com"/>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.PhoneNumber">Phone number <span style="color: var(--text-muted); font-weight: 400;">(optional)</span></label>
                        <input class="form-control" asp-for="Input.PhoneNumber" placeholder="+1 (555) 000-0000"/>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Password">Password</label>
                        <input class="form-control" asp-for="Input.Password" placeholder="Minimum 8 characters" autocomplete="new-password"/>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword">Confirm password</label>
                        <input class="form-control" asp-for="Input.ConfirmPassword" placeholder="Re-enter your password" autocomplete="new-password"/>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Create account</button>
                </form>
            </div>
        </div>

        <div class="mt-3">
            <p>Already have an account? <a asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.Input.ReturnUrl">Sign in</a></p>
        </div>
    }
</div>
