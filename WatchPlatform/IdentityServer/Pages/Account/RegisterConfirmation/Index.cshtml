@page
@model IdentityServer.Pages.RegisterConfirmation.Index

<div class="register-confirmation-page">
    <div class="lead">
        <h1>Verify your email</h1>
        <p>We've sent a confirmation link to your email</p>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="alert alert-info" style="margin-bottom: 1rem;">
                We've sent a verification email to <strong>@Model.Email</strong>. Click the link in the email to activate your account.
            </div>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0;">
                Didn't receive the email? Check your spam folder.
            </p>
        </div>
    </div>

    <div class="mt-3">
        <p><a asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a></p>
    </div>
</div>
