@page
@model IdentityServer.Pages.ResetPassword.Index

<div class="reset-password-page">
    <div class="lead">
        <h1>Set new password</h1>
        <p>Create a strong password for your account</p>
    </div>

    <partial name="_ValidationSummary"/>

    <div class="card">
        <div class="card-body">
            <form asp-page="/Account/ResetPassword/Index" method="post">
                <input type="hidden" asp-for="Input.Code"/>

                <div class="form-group">
                    <label asp-for="Input.Email">Email address</label>
                    <input class="form-control" asp-for="Input.Email" placeholder="name@example.com" autofocus/>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password">New password</label>
                    <input class="form-control" asp-for="Input.Password" placeholder="Minimum 8 characters" autocomplete="new-password"/>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                    <input class="form-control" asp-for="Input.ConfirmPassword" placeholder="Re-enter your password" autocomplete="new-password"/>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Reset password</button>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <p><a asp-page="/Account/Login/Index">Back to sign in</a></p>
    </div>
</div>
