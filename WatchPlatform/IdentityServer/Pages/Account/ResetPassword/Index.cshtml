@page
@model IdentityServer.Pages.ResetPassword.Index

<div class="reset-password-page">
    <div class="lead">
        <h1>Reset Password</h1>
        <p>Enter your new password</p>
    </div>

    <partial name="_ValidationSummary"/>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h2>Set New Password</h2>
                </div>

                <div class="card-body">
                    <form asp-page="/Account/ResetPassword/Index" method="post">
                        <input type="hidden" asp-for="Input.Code"/>

                        <div class="form-group">
                            <label asp-for="Input.Email"></label>
                            <input class="form-control" asp-for="Input.Email" autofocus/>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Password"></label>
                            <input class="form-control" asp-for="Input.Password" autocomplete="new-password"/>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.ConfirmPassword"></label>
                            <input class="form-control" asp-for="Input.ConfirmPassword" autocomplete="new-password"/>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Reset Password</button>
                    </form>
                </div>
            </div>

            <div class="mt-3">
                <p><a asp-page="/Account/Login/Index">Back to Login</a></p>
            </div>
        </div>
    </div>
</div>
